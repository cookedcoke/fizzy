# Copy to .env and fill in. Never commit .env. Blank values use the default.

# Shared staff password and session signing key.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FIZZY_PASSWORD=
FIZZY_SECRET_KEY=
FIZZY_STAFF=Will,Mike,Frankie
FIZZY_TZ=Australia/Sydney
# Set to 0 only when testing over plain http://localhost
FIZZY_SECURE_COOKIES=1
# Daily backups (Docker sets this to /backups automatically)
# FIZZY_BACKUP_DIR=
FIZZY_BACKUP_KEEP=30

# Student site (README: "Student site"): students check their own points and tab here
# FIZZY_PUBLIC_HOST=my.cookedcoke.co

# Discord: announce new rewards and double points days (channel → Integrations → Webhooks)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_MENTION=@everyone

# Optional device lock (README: "Locking it to the counter device")
FIZZY_HOST=fizzy.cookedcoke.co
# FIZZY_ACCESS_HOST=fizzy-remote.cookedcoke.co
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Square (Developer Dashboard > your app > Credentials / Locations / Webhooks)
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=production
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://fizzy.cookedcoke.co/square/webhook
SQUARE_POLL_SECONDS=300
# Only import sales from this date onwards (YYYY-MM-DD). Default: 1 day before first sync.
SQUARE_SYNC_FROM=
# How tab activity is recognised in Square (see README section 3)
SQUARE_TAB_DISCOUNT=fizzy tab
SQUARE_REPAYMENT_ITEM=tab repayment
# Optional fallback only: payment types that also mean "on the tab"
SQUARE_TAB_TENDERS=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
