{
  "name": "fizzy-counter",
  "productName": "Fizzy",
  "version": "1.0.0",
  "description": "Fizzy at the counter: staff window and customer display",
  "author": "Cooked Coke",
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --universal && codesign --force --deep --sign - dist/mac-universal/Fizzy.app"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "co.cookedcoke.fizzy",
    "productName": "Fizzy",
    "copyright": "Cooked Coke",
    "directories": { "output": "dist" },
    "files": ["src/**", "assets/**", "package.json"],
    "mac": {
      "target": ["dir"],
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "identity": null
    }
  }
}
